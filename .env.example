# Frontend (Netlify)
# Full public URL of the deployed Render API, without a trailing slash.
VITE_API_URL="https://simbiz-api.onrender.com/api"

# Backend (Render)
NODE_ENV="production"
PORT="10000"
# Exact Netlify origin allowed by the API, for example https://app.example.com.
CORS_ORIGIN="https://app.example.com"
# The JSON prototype store must point to a persistent disk in production.
SIMBIZ_STORAGE_MODE="filesystem"
SIMBIZ_DATA_DIR="/var/data"

# Reserved production boundary. The API currently rejects this variable rather
# than silently ignoring it until a PostgreSQL-compatible adapter is implemented.
DATABASE_URL=""

# Optional local/AI Studio variable.
GEMINI_API_KEY=""
