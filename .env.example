# Netlify frontend and Functions
# Leave empty for same-origin /api requests (the recommended all-free setup).
VITE_API_URL=""
# Only needed when calling the API from a separate origin.
CORS_ORIGIN=""
# Netlify Functions use memory by default. Data is not durable across cold starts.
SIMBIZ_STORAGE_MODE="memory"

# Local Express development only
NODE_ENV="development"
PORT="8787"
SIMBIZ_DATA_DIR="./server/data"

# Optional local/AI Studio variable.
GEMINI_API_KEY=""
